# Splunk CLI 配置示例（项目内 ./.env 用法）
#
# 常规使用推荐全局配置目录：安装后首次运行会自动创建
# ~/.splunk-cli/config.env，填一次即可，无需在每个工作目录重复配置。
#
#   splunk-cli init      # 创建 ~/.splunk-cli/config.env
#   splunk-cli config    # 查看生效配置（密钥脱敏）
#
# 本文件用于需要项目级配置的场景：复制成 `.env`（已被 git 忽略），
# 或直接导出为真实环境变量。绝不提交真实凭据。
#
#   cp .env.example .env
#   $EDITOR .env
#
# 优先级（高 → 低）：
#   SPLUNK_* 环境变量 > ~/.splunk-cli/config.env > ./.env > 内置默认值

# 全局配置目录位置（可选；默认 ~/.splunk-cli）。
# SPLUNK_CONFIG_DIR=

# Splunk 主机名或 IP：不带协议、不带端口。
# 示例：splunk.internal（主机名）、10.0.0.5（IP）。
SPLUNK_HOST=

# REST API 管理端口。注意：8000 是 Web UI 端口，不是 API 端口。
SPLUNK_PORT=8089

# 可选：改用 http://（仅开发环境）。
# SPLUNK_INSECURE=false

# 可选：完整 URL，设置后覆盖 SPLUNK_HOST / SPLUNK_PORT（反代或带路径前缀时用）。
# SPLUNK_URL=https://splunk.example.com/api

# 凭据。
# 账号名示例：admin（内置管理员）、ci_reader（建议用专用的只读账号）。
SPLUNK_USERNAME=
# 密码（必填；不会被打印，`config` 只显示 <set> / <unset>）。
SPLUNK_PASSWORD=

# TLS 校验。默认开启：客户端会验证服务端身份。
#   true  -> 默认值。Splunk 默认安装的证书（SplunkServerDefaultCert）由 Splunk 自己的 CA
#            签发、且没有 SAN 扩展，所以对默认安装**会失败**：按下面的说明配好 CA，或把本行
#            改成 false（仅开发环境）。两种情况连接都**始终加密**。
#   false -> 跳过"证明对端身份"这一步，仅用于开发环境。
SPLUNK_VERIFY_SSL=true

# CA 证书路径（PEM）。只要 SPLUNK_VERIFY_SSL=true 且证书不是公共 CA 签发的，就必须配。
# 取自服务端发出的**整条链**（叶子 + 签发它的 CA）；只截取叶子无法建立信任：
#   openssl s_client -connect <host>:8089 -showcerts </dev/null 2>/dev/null \
#     | sed -n '/BEGIN CERTIFICATE/,/END CERTIFICATE/p' > splunk-ca.pem
# 证书还必须带覆盖你连接所用名字的 SAN——按 IP 连接需要 iPAddress SAN，CN 不参与 IP 匹配。
# SPLUNK_CA_BUNDLE=/path/to/splunk-ca.pem

# 单次 HTTP 请求超时（秒）。
SPLUNK_TIMEOUT=30

# 安全上限：超出即拒绝，绝不静默改写用户参数。
SPLUNK_MAX_RESULTS=5000
SPLUNK_MAX_TIME_RANGE=7d

# 搜索 Job 的运行参数（不是上限；`splunk-cli limits` 会把它们一并打印）。
# 状态轮询间隔（秒，取值 (0, 60]）：Job 建好后每隔多久问一次"完成了吗"。
# 调小 = 状态查询更频繁；调大 = 完成检测更晚（总预算不受影响）。
SPLUNK_POLL_INTERVAL=1

# 单个搜索 Job 的墙上时钟预算（秒，取值 (0, 3600]）。
# 实际生效值 = max(SPLUNK_SEARCH_TIMEOUT, SPLUNK_TIMEOUT)，所以只调小这一行可能不生效。
# SPLUNK_SEARCH_TIMEOUT=60

# HTTP 重试策略（仅传输层；认证失败与 4xx 绝不重试）。
# SPLUNK_MAX_RETRIES=3
# SPLUNK_RETRY_BACKOFF=0.5

# SPL 查询最大长度（字符数）。
# SPLUNK_MAX_QUERY_LENGTH=10000

# 是否使用代理环境变量与系统代理设置。
# 默认 false：Splunk 通常在内网，若静默走开发机代理会产生难以排查的网关错误。
# SPLUNK_TRUST_ENV=false
